    "lucide-react": "^1.35.0",
    "mqtt": "5.16.1",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "qrcode": "1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.17",
